---
import type { Question } from '../content.config';
import QuestionBody from './QuestionBody.astro';
import { PASS_MARK, MINUTES_PER_K, EXAM_MINUTES, url } from '../lib/site';
import { getChapters } from '../lib/data';
import { getSummaries } from '../lib/summaries';

/**
 * Udemy-style quiz: answer everything, submit, then see a score and a full review
 * explaining why each option is right or wrong. Explanations are rendered at build
 * time and revealed by the client script after submission.
 */
interface Props {
  questions: Question[];
  quizId: string;
  /** Full mock exam: adds a start screen, an optional countdown and a per-domain breakdown. */
  examMode?: boolean;
  /** Exam time in minutes; defaults to the real exam's. A shorter paper gets the same pace. */
  examMinutes?: number;
}
const { questions, quizId, examMode = false, examMinutes = EXAM_MINUTES } = Astro.props;
const fullExam = examMinutes === EXAM_MINUTES;
// Results breakdown: by domain on mock exams, by section on a single-domain quiz.
const chapters = await getChapters();
const sections = (await getSummaries()).flatMap((d) => d.sections.map((x) => ({ ...x, chapter: d.number })));
const SHORT: Record<number, string> = { 1: 'Agents and workflows', 2: 'API and apps', 3: 'Claude Code', 4: 'Evals and debugging', 5: 'Models and cost', 6: 'Prompts and context', 7: 'Security', 8: 'Tools and MCP' };
const groupOf = (q: Question) => (examMode ? String(q.chapter) : q.ref.split(' ')[0]);
const groups = [...new Set(questions.map(groupOf))].sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).map((g) => {
  const n = questions.filter((q) => groupOf(q) === g).length;
  if (examMode) {
    const ch = chapters.find((c) => c.data.number === Number(g));
    return { key: g, n, label: `${g}. ${SHORT[Number(g)] ?? ch?.data.title ?? ''}`, weight: ch?.data.weight ?? 0, href: url(`chapters/${g}/#domain-summary`) };
  }
  const sec = sections.find((x) => x.number === g);
  return { key: g, n, label: `${g} ${sec?.title ?? ''}`, weight: n, href: sec ? url(`chapters/${sec.chapter}/#${sec.slug}`) : '#' };
});
const total = questions.length;
const passScore = Math.ceil(total * PASS_MARK);
const minutes = Math.ceil(questions.reduce((m, q) => m + MINUTES_PER_K[q.k], 0));
---
<section id="quiz" data-testid="quiz" class:list={['quiz', { 'is-exam': examMode }]} data-quiz-id={quizId} data-pass-mark={PASS_MARK} data-exam={examMode ? '' : undefined}>
  <div class="card quiz-intro no-print">
    <dl>
      <div><dt>Questions</dt><dd id="question-count" data-testid="question-count">{total}</dd></div>
      <div><dt>Practice target</dt><dd id="pass-mark" data-testid="pass-mark" title="The real exam is a scaled score: 720 on a 100–1,000 scale, not a fixed percentage. 72% is a rough practice target.">{passScore} / {total} (≈72%)</dd></div>
      {examMode
        ? <div><dt>Time allowed</dt><dd>{examMinutes} min</dd></div>
        : <div><dt>Suggested time</dt><dd>~{minutes} min</dd></div>}
    </dl>
    <label class="paged-toggle no-print"><input type="checkbox" id="one-at-a-time" name="one-at-a-time" data-testid="one-at-a-time-toggle" data-paged-toggle checked={total > 20} /> Show one question at a time</label>
    <p class="last-attempt" id="last-attempt" data-testid="last-attempt" hidden data-last-attempt></p>
    {examMode && (
      <div class="resume" data-resume hidden data-testid="exam-resume">
        <p><strong>You have an exam in progress.</strong> <span data-resume-text></span></p>
        <div class="resume__btns">
          <button class="btn" type="button" data-resume-yes data-testid="resume-exam">Resume where I left off</button>
          <button class="link-btn" type="button" data-resume-no data-testid="restart-exam">Start again</button>
        </div>
      </div>
      <div class="start" id="exam-start" data-testid="exam-start" data-start>
        <label for="time-limit">Time limit
          <select id="time-limit" name="time-limit" data-testid="time-limit" data-time-limit>
            {fullExam
              ? <><option value="120">120 minutes — same as the real exam</option><option value="90">90 minutes — challenge mode</option></>
              : <option value={examMinutes}>{examMinutes} minutes — the real exam's pace</option>}
            <option value="0">No time limit</option>
          </select>
        </label>
        <button class="btn" type="button" id="start-exam" data-testid="start-exam" data-start-btn>Start exam</button>
      </div>
    )}
  </div>

  <div class="results card card--dark" id="results" data-testid="results" hidden data-results tabindex="-1">
    <div class="score">
      <span class="eyebrow" id="verdict" data-testid="verdict" data-verdict-label></span>
      <p class="score__big"><span id="score" data-testid="score" data-score></span><span class="score__of" data-testid="score-total"> / {total}</span></p>
      <p class="score__pct" id="score-percent" data-testid="score-percent" data-percent></p>
      <p class="score__time" id="time-taken" data-testid="time-taken" data-time-taken hidden></p>
    </div>
    {groups.length > 1 && (
      <div class="breakdown-wrap" data-breakdown-wrap>
        <table class="breakdown" id="chapter-breakdown" data-testid="chapter-breakdown" data-breakdown>
          <caption class="visually-hidden">Score by {examMode ? 'domain' : 'section'}</caption>
          <thead><tr><th scope="col">{examMode ? 'Domain' : 'Section'}</th><th scope="col">Score</th><th scope="col"><span class="visually-hidden">Bar</span></th></tr></thead>
          <tbody>
            {groups.map((g) => (
              <tr data-testid={`breakdown-chapter-${g.key}`} data-group-row={g.key} data-weight={g.weight} data-label={g.label} data-href={g.href}>
                <th scope="row"><a href={g.href}>{g.label}</a>{examMode && <span class="breakdown__w">{g.weight}% of the exam</span>}</th>
                <td data-testid={`breakdown-chapter-${g.key}-score`} data-chapter-score>0 / {g.n}</td>
                <td><span class="mini"><span data-chapter-bar></span></span></td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="focus" data-focus hidden></p>
      </div>
    )}
    <div class="results__actions no-print">
      <label class="toggle"><input type="checkbox" id="only-wrong" name="only-wrong" data-testid="only-wrong-toggle" data-only-wrong /> Show only questions I got wrong</label>
      <button class="btn" type="button" id="retake" data-testid="retake" data-retake>Retake quiz</button>
    </div>
  </div>

  <form class="questions" id="quiz-form" name="quiz" data-testid="quiz-form" data-form novalidate hidden={examMode}>
    <ol>
      {questions.map((q, i) => (
        <li class="q card" id={`question-${q.id}`} data-testid={`question-${i + 1}`} data-question={q.id} data-answer={q.answer.join(',')} data-select={q.select} data-chapter={q.chapter} data-group={groupOf(q)}>
          <header class="q__head">
            <span class="q__num" data-testid={`question-${i + 1}-number`}>Question {i + 1}<span class="muted"> of {total}</span></span>
            <span class="q__tags">
              {examMode && <span class="pill">Domain {q.chapter}</span>}
              <span class="pill" data-testid={`question-${i + 1}-section`}>{q.ref}</span>
              <span class="pill pill--dark" title="Question type" data-testid={`question-${i + 1}-k-level`}>{q.k}</span>
              <a class="pill pill--source" href={q.source.url} target="_blank" rel="noopener" title={`Based on the official Claude resource: ${q.source.title} (opens in a new tab)`} data-testid={`question-${i + 1}-source`}>📚 {q.source.title} ↗</a>
            </span>
          </header>
          <QuestionBody blocks={q.blocks} label={`question ${i + 1}`} />
          <fieldset>
            <legend class="q__instruction" data-testid={`question-${i + 1}-instruction`}>Select {q.select === 2 ? 'TWO options' : 'ONE option'}</legend>
            {q.options.map((o) => (
              <label class="opt" for={`question-${q.id}-option-${o.key}`} data-testid={`question-${i + 1}-option-${o.key}`} data-option={o.key}>
                <input type={q.select === 2 ? 'checkbox' : 'radio'} id={`question-${q.id}-option-${o.key}`} name={`question-${q.id}`} value={o.key} data-testid={`question-${i + 1}-option-${o.key}-input`} />
                <span class="opt__key">{o.key}</span>
                <span class="opt__text">{o.text}</span>
                <span class="opt__flag" aria-hidden="true"></span>
              </label>
            ))}
          </fieldset>
          <div class="review" hidden data-testid={`question-${i + 1}-review`} data-review>
            <p class="review__verdict" data-testid={`question-${i + 1}-verdict`} data-verdict></p>
            {q.explanation.intro && <p class="review__intro">{q.explanation.intro}</p>}
            <ul class="review__options">
              {q.options.map((o) => q.explanation.options[o.key] && (
                <li data-testid={`question-${i + 1}-explanation-${o.key}`} data-explain={o.key}><strong>{o.key})</strong> {q.explanation.options[o.key]}</li>
              ))}
            </ul>
            <p class="review__source muted">Practice question {q.n} · {q.lo} · Based on <a href={q.source.url} target="_blank" rel="noopener">{q.source.title} ↗</a></p>
          </div>
        </li>
      ))}
    </ol>

    <div class="submit-bar no-print" id="submit-bar" data-testid="submit-bar" data-submit-bar>
      <span><strong id="answered-count" data-testid="answered-count" data-answered>0</strong> of {total} answered</span>
      <span class="pager-controls" data-pager>
        <button type="button" class="pager-btn" id="previous-question" data-testid="previous-question" data-prev aria-label="Previous question">←</button>
        <span id="question-position" data-testid="question-position" data-position></span>
        <button type="button" class="pager-btn" id="next-question" data-testid="next-question" data-next aria-label="Next question">→</button>
      </span>
      <button type="button" class="link-btn" id="jump-to-unanswered" data-testid="jump-to-unanswered" data-jump>Jump to unanswered</button>
      {examMode && <span class="timer" id="timer" data-testid="timer" data-timer hidden aria-live="off"></span>}
      <button class="btn" type="submit" id="submit-answers" data-testid="submit-answers">Submit answers</button>
      <div class="confirm-bar" data-confirm hidden role="alert">
        <span data-confirm-text></span>
        <button type="button" class="btn btn--small" data-confirm-yes data-testid="confirm-submit">Submit anyway</button>
        <button type="button" class="link-btn" data-confirm-no data-testid="confirm-cancel">Keep going</button>
      </div>
    </div>
  </form>
  {examMode && (
    <div class="leave no-print" data-leave hidden role="alertdialog" aria-labelledby="leave-title" data-testid="leave-dialog">
      <div class="leave__box card">
        <p id="leave-title"><strong>Are you sure you want to leave?</strong></p>
        <p>You can resume where you left off when you come back and select the same test, or start again.</p>
        <div class="leave__btns">
          <button type="button" class="btn" data-leave-stay data-testid="leave-stay">Stay in the exam</button>
          <button type="button" class="link-btn" data-leave-go data-testid="leave-go">Leave</button>
        </div>
      </div>
    </div>
  )}
</section>

<script>
  import { getQuiz, saveQuizAttempt, type QuizAttempt } from '../lib/progress';

  for (const quiz of document.querySelectorAll<HTMLElement>('[data-quiz-id]')) {
    const id = quiz.dataset.quizId!;
    const passMark = Number(quiz.dataset.passMark);
    const form = quiz.querySelector<HTMLFormElement>('[data-form]')!;
    const items = [...quiz.querySelectorAll<HTMLElement>('[data-question]')];
    const results = quiz.querySelector<HTMLElement>('[data-results]')!;
    const answeredEl = quiz.querySelector<HTMLElement>('[data-answered]')!;
    const onlyWrong = quiz.querySelector<HTMLInputElement>('[data-only-wrong]')!;

    const chosen = (item: HTMLElement) =>
      [...item.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value).sort();
    const isAnswered = (item: HTMLElement) => chosen(item).length === Number(item.dataset.select);

    const updateCount = () => {
      answeredEl.textContent = String(items.filter(isAnswered).length);
      quiz.querySelector<HTMLElement>('[data-jump]')!.hidden = items.every(isAnswered);
    };

    // ---- One question at a time
    const pagedToggle = quiz.querySelector<HTMLInputElement>('[data-paged-toggle]')!;
    const position = quiz.querySelector<HTMLElement>('[data-position]')!;
    let current = 0;
    function show(i: number, scroll = true) {
      current = Math.max(0, Math.min(items.length - 1, i));
      items.forEach((it, k) => it.classList.toggle('is-current', k === current));
      position.textContent = `${current + 1} / ${items.length}`;
      if (scroll && quiz.classList.contains('is-paged')) items[current].scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function setPaged(on: boolean) {
      quiz.classList.toggle('is-paged', on);
      show(current, false);
    }
    pagedToggle.addEventListener('change', () => setPaged(pagedToggle.checked));
    quiz.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    quiz.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    setPaged(pagedToggle.checked);

    // ---- Jump to the first unanswered question
    quiz.querySelector('[data-jump]')!.addEventListener('click', () => {
      const i = items.findIndex((it) => !isAnswered(it));
      if (i < 0) return;
      if (quiz.classList.contains('is-paged')) show(i);
      else items[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // "Select TWO" questions: stop a third box being ticked.
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const item = input.closest<HTMLElement>('[data-question]')!;
      if (input.type === 'checkbox' && chosen(item).length > Number(item.dataset.select)) input.checked = false;
      updateCount();
    });

    function mark(answers: Record<string, string[]>) {
      let score = 0;
      for (const item of items) {
        const correct = item.dataset.answer!.split(',');
        const picked = answers[item.dataset.question!] ?? [];
        const right = picked.length === correct.length && picked.every((k) => correct.includes(k));
        if (right) score++;
        item.classList.add(right ? 'is-right' : 'is-wrong');
        item.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.checked = picked.includes(input.value);
          input.disabled = true;
          const label = input.closest<HTMLElement>('.opt')!;
          label.classList.toggle('is-correct', correct.includes(input.value));
          label.classList.toggle('is-picked-wrong', input.checked && !correct.includes(input.value));
        });
        item.querySelectorAll<HTMLElement>('[data-explain]').forEach((li) => {
          li.classList.toggle('is-correct', correct.includes(li.dataset.explain!));
          li.classList.toggle('is-picked', picked.includes(li.dataset.explain!));
        });
        const verdict = item.querySelector<HTMLElement>('[data-verdict]')!;
        verdict.textContent = right
          ? 'Correct!'
          : picked.length
            ? `Not quite. You chose ${picked.join(' and ')}; the answer is ${correct.join(' and ')}.`
            : `Not answered. The answer is ${correct.join(' and ')}.`;
        item.querySelector<HTMLElement>('[data-review]')!.hidden = false;
      }
      return score;
    }

    const isExam = quiz.hasAttribute('data-exam');
    const timerEl = quiz.querySelector<HTMLElement>('[data-timer]');
    let startedAt = Date.now();
    let tick: number | undefined;
    const fmt = (sec: number) => `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;

    // ---- An exam in progress is saved, so leaving the page doesn't lose it.
    const SAVE_KEY = `ccdvf-exam-in-progress-${id}`;
    type Saved = { answers: Record<string, string[]>; elapsed: number; limit: number; current: number };
    let running = false;
    let limitSecs = 0;
    const readSaved = (): Saved | null => { try { const r = localStorage.getItem(SAVE_KEY); return r ? JSON.parse(r) : null; } catch { return null; } };
    const clearSaved = () => { try { localStorage.removeItem(SAVE_KEY); } catch { /* storage unavailable */ } };
    function save() {
      if (!isExam || !running) return;
      const answers = Object.fromEntries(items.map((i) => [i.dataset.question!, chosen(i)]));
      const data: Saved = { answers, elapsed: Math.round((Date.now() - startedAt) / 1000), limit: limitSecs, current };
      try { localStorage.setItem(SAVE_KEY, JSON.stringify(data)); } catch { /* storage unavailable */ }
    }
    form.addEventListener('change', save);

    function startExam(resume?: Saved) {
      const limit = resume ? resume.limit : Number(quiz.querySelector<HTMLSelectElement>('[data-time-limit]')!.value) * 60;
      limitSecs = limit;
      quiz.querySelector<HTMLElement>('[data-start]')!.hidden = true;
      quiz.querySelector<HTMLElement>('[data-resume]')!.hidden = true;
      form.hidden = false;
      startedAt = Date.now() - (resume ? resume.elapsed * 1000 : 0);
      if (resume) {
        for (const item of items) {
          const picked = resume.answers[item.dataset.question!] ?? [];
          item.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = picked.includes(input.value); });
        }
        updateCount();
        show(resume.current ?? 0, false);
      }
      running = true;
      save();
      if (limit && timerEl) {
        timerEl.hidden = false;
        const update = () => {
          const left = limit - Math.floor((Date.now() - startedAt) / 1000);
          timerEl.textContent = `⏱ ${fmt(Math.max(left, 0))} left`;
          timerEl.classList.toggle('is-low', left <= 300);
          if (left <= 0) { window.clearInterval(tick); submit(true); }
          else save();
        };
        update();
        tick = window.setInterval(update, 1000);
      }
      if (!limit) tick = window.setInterval(save, 5000);
      (resume ? items[resume.current ?? 0] : items[0])?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    quiz.querySelector('[data-start-btn]')?.addEventListener('click', () => { clearSaved(); startExam(); });

    // Offer to resume a saved exam.
    const resumeBox = quiz.querySelector<HTMLElement>('[data-resume]');
    const saved = isExam ? readSaved() : null;
    if (resumeBox && saved) {
      const done = Object.values(saved.answers).filter((a) => a.length).length;
      const left = saved.limit ? ` · ${fmt(Math.max(saved.limit - saved.elapsed, 0))} left on the clock` : '';
      resumeBox.querySelector('[data-resume-text]')!.textContent = `${done} of ${items.length} answered${left}. The clock stopped while you were away.`;
      resumeBox.hidden = false;
      quiz.querySelector<HTMLElement>('[data-start]')!.hidden = true;
      resumeBox.querySelector('[data-resume-yes]')!.addEventListener('click', () => startExam(saved));
      resumeBox.querySelector('[data-resume-no]')!.addEventListener('click', () => {
        clearSaved();
        resumeBox.hidden = true;
        quiz.querySelector<HTMLElement>('[data-start]')!.hidden = false;
      });
    }

    // Warn before leaving an exam that's under way. Browser pop-ups are blocked in embedded previews, so ask on the page.
    const leaveEl = quiz.querySelector<HTMLElement>('[data-leave]');
    let leaveTo = '';
    document.addEventListener('click', (e) => {
      if (!running || !leaveEl) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!a || a.target === '_blank' || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const dest = new URL(a.href, location.href);
      if (dest.pathname === location.pathname && dest.hash) return;
      e.preventDefault();
      save();
      leaveTo = a.href;
      leaveEl.hidden = false;
      leaveEl.querySelector<HTMLButtonElement>('[data-leave-stay]')!.focus();
    }, true);
    leaveEl?.querySelector('[data-leave-stay]')!.addEventListener('click', () => { leaveEl.hidden = true; });
    leaveEl?.querySelector('[data-leave-go]')!.addEventListener('click', () => { running = false; location.href = leaveTo; });
    leaveEl?.addEventListener('keydown', (e) => { if (e.key === 'Escape') leaveEl.hidden = true; });
    quiz.querySelectorAll('[data-prev], [data-next]').forEach((b) => b.addEventListener('click', save));
    window.addEventListener('beforeunload', (e) => { if (running) { save(); e.preventDefault(); } });

    function fillBreakdown(attempt: QuizAttempt) {
      const stats: { label: string; href: string; pct: number; weight: number }[] = [];
      for (const row of quiz.querySelectorAll<HTMLElement>('[data-group-row]')) {
        const key = row.dataset.groupRow!;
        const qs = items.filter((i) => i.dataset.group === key);
        const right = qs.filter((i) => {
          const correct = i.dataset.answer!.split(',');
          const picked = attempt.answers[i.dataset.question!] ?? [];
          return picked.length === correct.length && picked.every((k) => correct.includes(k));
        }).length;
        const pct = Math.round((right / qs.length) * 100);
        row.querySelector('[data-chapter-score]')!.textContent = `${right} / ${qs.length} (${pct}%)`;
        row.querySelector<HTMLElement>('[data-chapter-bar]')!.style.width = `${pct}%`;
        row.classList.toggle('is-weak', pct < passMark * 100);
        stats.push({ label: row.dataset.label!, href: row.dataset.href!, pct, weight: Number(row.dataset.weight) });
      }
      // Suggest where to revise: the weakest areas, giving more weight to the ones worth more of the exam.
      const focus = quiz.querySelector<HTMLElement>('[data-focus]');
      if (!focus) return;
      const weak = stats.filter((x) => x.pct < passMark * 100).sort((a, b) => (100 - b.pct) * b.weight - (100 - a.pct) * a.weight).slice(0, 2);
      focus.hidden = false;
      focus.innerHTML = weak.length
        ? 'Revise next: ' + weak.map((w) => `<a href="${w.href}">${w.label}</a> (${w.pct}%)`).join(' and ') + '.' + (isExam ? ' <span class="focus__why">Picked by low score and by how much of the exam each domain covers.</span>' : '')
        : 'Every area is at or above the practice target. Well done.';
    }

    function showResults(attempt: QuizAttempt) {
      form.hidden = false;
      const startEl = quiz.querySelector<HTMLElement>('[data-start]');
      if (startEl) startEl.hidden = true;
      if (timerEl) timerEl.hidden = true;
      fillBreakdown(attempt);
      const timeEl = quiz.querySelector<HTMLElement>('[data-time-taken]')!;
      timeEl.hidden = !attempt.seconds;
      if (attempt.seconds) timeEl.textContent = `Time taken: ${fmt(attempt.seconds)}`;
      quiz.classList.add('is-marked');
      quiz.querySelector('[data-submit-bar]')!.setAttribute('hidden', '');
      results.hidden = false;
      results.classList.toggle('is-pass', attempt.passed);
      quiz.querySelector('[data-score]')!.textContent = String(attempt.score);
      quiz.querySelector('[data-percent]')!.textContent = `${attempt.percent}% · practice target ≈72% (the real exam uses a scaled score of 720/1,000)`;
      quiz.querySelector('[data-verdict-label]')!.textContent = attempt.passed ? 'Pass - well done' : 'Not a pass yet - review below';
      results.focus();
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const confirmBar = quiz.querySelector<HTMLElement>('[data-confirm]')!;
    const confirmText = quiz.querySelector<HTMLElement>('[data-confirm-text]')!;
    confirmBar.querySelector('[data-confirm-yes]')!.addEventListener('click', () => submit(false, true));
    confirmBar.querySelector('[data-confirm-no]')!.addEventListener('click', () => { confirmBar.hidden = true; });
    function submit(timeUp = false, force = false) {
      const unanswered = items.filter((i) => !isAnswered(i)).length;
      if (!timeUp && unanswered && !force) {
        // Browser pop-ups (confirm) are blocked inside embedded previews, so ask on the page instead.
        confirmText.textContent = `You have ${unanswered} unanswered question${unanswered === 1 ? '' : 's'}.`;
        confirmBar.hidden = false;
        confirmBar.querySelector<HTMLButtonElement>('[data-confirm-yes]')!.focus();
        return;
      }
      confirmBar.hidden = true;
      window.clearInterval(tick);
      running = false;
      clearSaved();
      const answers = Object.fromEntries(items.map((i) => [i.dataset.question!, chosen(i)]));
      const score = mark(answers);
      const percent = Math.round((score / items.length) * 100);
      const attempt: QuizAttempt = {
        score, total: items.length, percent, passed: score / items.length >= passMark,
        date: new Date().toISOString(), answers,
        seconds: isExam ? Math.round((Date.now() - startedAt) / 1000) : undefined,
      };
      saveQuizAttempt(id, attempt);
      showResults(attempt);
      if (timeUp) {
        const timeEl = quiz.querySelector<HTMLElement>('[data-time-taken]')!;
        timeEl.hidden = false;
        timeEl.textContent = "Time's up: your exam has been marked. " + timeEl.textContent;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submit();
    });

    quiz.querySelector('[data-retake]')!.addEventListener('click', () => {
      clearSaved();
      quiz.classList.remove('is-marked', 'only-wrong');
      onlyWrong.checked = false;
      results.hidden = true;
      quiz.querySelector('[data-submit-bar]')!.removeAttribute('hidden');
      for (const item of items) {
        item.classList.remove('is-right', 'is-wrong');
        item.querySelector<HTMLElement>('[data-review]')!.hidden = true;
        item.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.checked = false;
          input.disabled = false;
          input.closest('.opt')!.classList.remove('is-correct', 'is-picked-wrong');
        });
      }
      updateCount();
      if (isExam) {
        form.hidden = true;
        quiz.querySelector<HTMLElement>('[data-start]')!.hidden = false;
      }
      quiz.scrollIntoView({ behavior: 'smooth' });
    });

    onlyWrong.addEventListener('change', () => quiz.classList.toggle('only-wrong', onlyWrong.checked));

    // Offer the previous attempt, if there is one.
    const record = getQuiz(id);
    const lastEl = quiz.querySelector<HTMLElement>('[data-last-attempt]')!;
    if (record) {
      const { last, best } = record;
      const when = new Date(last.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      lastEl.hidden = false;
      lastEl.innerHTML = `Last attempt: <strong>${last.percent}%</strong> on ${when} · Best: <strong>${best.percent}%</strong> · ${record.attempts} attempt(s) <button type="button" class="link-btn" id="review-last-attempt" data-testid="review-last-attempt">Review last attempt</button>`;
      lastEl.querySelector('button')!.addEventListener('click', () => {
        mark(last.answers);
        showResults(last);
      });
    }
    updateCount();
  }
</script>

