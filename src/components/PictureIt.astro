---
/**
 * "Picture it": a concrete, real-life walk-through of a topic: the actual code, the actual request or
 * response, and what you'd see when it goes wrong. Write Markdown (and <CodeSwitch>) inside.
 *   <PictureIt title="What a request really looks like">…</PictureIt>
 */
interface Props { title: string; }
const { title } = Astro.props;
---
<section class="picture" data-testid="picture-it">
  <p class="picture__head"><span class="picture__icon" aria-hidden="true">🎬</span><span><span class="eyebrow">Picture it · real life</span><strong class="picture__title">{title}</strong></span></p>
  <div class="picture__body"><slot /></div>
</section>

<style>
  .picture { margin: 1.5rem 0; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); border-top: 6px solid var(--charcoal); overflow: hidden; }
  .picture__head { display: flex; gap: 0.75rem; align-items: center; margin: 0; padding: 1rem 1.4rem; background: var(--bg); border-bottom: 1px solid var(--line); }
  .picture__icon { flex: none; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--charcoal); font-size: 1.15rem; }
  .picture__head .eyebrow { margin-bottom: 0.1rem; }
  .picture__title { display: block; font: 700 1.2rem/1.25 var(--font-head); }
  .picture__body { padding: 0.5rem 1.4rem 1.1rem; }
  .picture__body :global(h4) { margin: 1.1rem 0 0.4rem; font-size: 1rem; color: var(--pink-dark); }
  .picture__body :global(pre.astro-code) { margin: 0.6rem 0; }
</style>
