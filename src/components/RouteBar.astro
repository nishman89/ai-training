---
/** Route bar: the path through a domain to the current section, shown under the section heading. */
interface Props { at: '1.2' | '1.3' | '1.4' | '1.5' | '8.2' | '8.3' | '8.4' | '8.5'; }
const { at } = Astro.props;

interface Chip { num?: string; label: string; id: string; }
const S: Record<string, Chip> = {
  '1.2': { num: '1.2', label: 'Pick a pattern', id: '12-the-five-workflow-patterns' },
  '1.3': { num: '1.3', label: 'The loop', id: '13-the-agent-loop' },
  '1.4': { num: '1.4', label: 'Who runs it', id: '14-who-runs-the-agent-loop' },
  '1.5': { num: '1.5', label: 'Long jobs', id: '15-memory-and-long-horizon-work' },
  '8.1': { num: '8.1', label: 'How a call works', id: '81-how-does-a-tool-call-work' },
  '8.2': { num: '8.2', label: 'Design it well', id: '82-how-do-i-design-a-tool-claude-uses-well' },
  '8.3': { num: '8.3', label: 'Who runs it', id: '83-who-runs-the-tool-and-when-does-claude-use-it' },
  '8.4': { num: '8.4', label: 'How MCP works', id: '84-how-do-i-share-tools-across-apps-with-mcp' },
  '8.5': { num: '8.5', label: 'Run it safely', id: '85-how-do-i-run-mcp-servers-safely' },
};
const workflow: Chip = { num: '1.1', label: "Your code decides the steps, so it's a workflow", id: '11-workflow-or-agent' };
const agent: Chip = { num: '1.1', label: "Claude decides the steps, so it's an agent", id: '11-workflow-or-agent' };
const inApp: Chip = { label: 'The tool lives in your app', id: 'the-map-of-this-domain' };
const shared: Chip = { label: 'The tool is shared across apps', id: 'the-map-of-this-domain' };
const basics: Chip = { num: '8.1–8.3', label: 'Tool basics', id: '81-how-does-a-tool-call-work' };

const ROUTES: Record<Props['at'], Chip[]> = {
  '1.2': [workflow, S['1.2']],
  '1.3': [agent, S['1.3']],
  '1.4': [agent, S['1.3'], S['1.4']],
  '1.5': [agent, S['1.3'], S['1.4'], S['1.5']],
  '8.2': [inApp, S['8.1'], S['8.2']],
  '8.3': [inApp, S['8.1'], S['8.2'], S['8.3']],
  '8.4': [shared, basics, S['8.4']],
  '8.5': [shared, basics, S['8.4'], S['8.5']],
};
const route = ROUTES[at];
const domain = at.split('.')[0];
---
<nav class="route not-prose" aria-label={`Where this section sits in Domain ${domain}`} data-testid={`route-${at}`}>
  {route.map((c, i) => {
    const now = i === route.length - 1;
    return (
      <>
        {i > 0 && <span class="arr" aria-hidden="true">→</span>}
        {now
          ? <span class="chip is-now" aria-current="location">{c.num && <b>{c.num}</b>} {c.label}</span>
          : <a class:list={['chip', { 'chip--start': i === 0 && !c.num }]} href={`#${c.id}`}>{c.num && <b>{c.num}</b>} {c.label}</a>}
      </>
    );
  })}
</nav>

<style>
  .route { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.45rem; margin: 0.25rem 0 1rem; padding: 0.7rem 0.9rem; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); font-size: 0.92rem; line-height: 1.3; }
  .chip { display: inline-flex; gap: 0.35rem; align-items: baseline; padding: 0.25rem 0.7rem; border-radius: 999px; border: 1.5px solid var(--pink); color: var(--pink-dark); text-decoration: none; background: transparent; }
  a.chip:hover { background: var(--pink-tint); }
  .chip b { font-weight: 800; }
  .chip--start { border-color: var(--charcoal); color: var(--charcoal); }
  .chip.is-now { background: var(--pink); color: #fff; }
  .arr { color: var(--grey); }
</style>
