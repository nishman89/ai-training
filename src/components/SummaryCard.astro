---
/**
 * One section's summary as a compact card: the "one thing" always visible, the other points and any
 * watch-out folded underneath. Used on the Summaries page and at the end of each domain.
 */
import type { SectionSummaryEntry } from '../lib/summaries';
import { WATCH_OUTS } from '../data/summary-watchouts';
interface Props { sec: SectionSummaryEntry; href: string; }
const { sec, href } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const fmt = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
const [key, ...rest] = sec.points;
const watch = WATCH_OUTS[sec.number] ?? [];
const more = rest.length + watch.length;
---
<article class="card sc" data-testid={`summary-${sec.number.replace('.', '-')}`}>
  <h3><a href={href}><span class="sc__no">{sec.number}</span> {sec.title}</a></h3>
  {key && <p class="sc__key"><span class="sc__tag">★ The one thing</span><span set:html={fmt(key)} /></p>}
  {more > 0 && (
    <details class="sc__more">
      <summary>{rest.length} more point{rest.length === 1 ? '' : 's'}{watch.length > 0 && ' + a watch-out'}</summary>
      <div class="sc__pts">
        {rest.map((p) => <p class="sc__pt" set:html={fmt(p)} />)}
        {watch.map((w) => <p class="sc__watch" data-testid="watch-out"><span class="sc__wtag">⚠ Watch out</span> <span set:html={fmt(w)} /></p>)}
      </div>
    </details>
  )}
</article>

<style>
  .sc { display: flex; flex-direction: column; gap: 0.6rem; border-top: 5px solid var(--charcoal); }
  .sc h3 { margin: 0; font-size: 1.1rem; }
  .sc h3 a { color: var(--charcoal); text-decoration: none; }
  .sc h3 a:hover { color: var(--pink-dark); }
  .sc__no { display: inline-block; min-width: 2.4rem; padding: 0.05rem 0.45rem; margin-right: 0.25rem; border-radius: 999px; background: var(--pink); color: #fff; font: 700 0.8rem var(--font-body); text-align: center; vertical-align: middle; }
  .sc__key { margin: 0; padding: 0.6rem 0.8rem; border-radius: 10px; background: var(--pink-tint); font-weight: 600; line-height: 1.5; }
  .sc__tag { display: block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pink-dark); margin-bottom: 0.15rem; }
  .sc__more > summary { cursor: pointer; font-weight: 700; font-size: 0.9rem; color: var(--pink-dark); list-style: none; padding: 0.2rem 0; }
  .sc__more > summary::-webkit-details-marker { display: none; }
  .sc__more > summary::before { content: '▸ '; }
  .sc__more[open] > summary::before { content: '▾ '; }
  .sc__pts { display: grid; gap: 0.45rem; margin-top: 0.4rem; }
  .sc__pt { position: relative; margin: 0; padding-left: 1.5rem; line-height: 1.5; font-size: 0.97rem; }
  .sc__pt::before { content: '✓'; position: absolute; left: 0; color: var(--pink); font-weight: 700; }
  .sc__watch { margin: 0.2rem 0 0; padding: 0.55rem 0.8rem; border-radius: 10px; background: #fff4e0; font-size: 0.95rem; line-height: 1.5; }
  .sc__wtag { font-weight: 800; color: #9a5b00; white-space: nowrap; }
  @media print { .sc__more { display: block; } .sc__more > summary { display: none; } .sc { break-inside: avoid; box-shadow: none; border: 1px solid var(--line); } }
</style>
