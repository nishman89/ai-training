---
/**
 * "Through your lens": the same idea as a developer, a test automation engineer, a data engineer and a BA would meet it.
 * Tabs switch between roles; the choice is remembered across pages. `backticks` become code.
 *   <RoleLens dev={"..."} test={"..."} data={"..."} ba={"..."} />
 */
interface Props { dev: string; test: string; data: string; ba: string; }
const p = Astro.props;
const ROLES = [
  { key: 'dev', icon: '👩‍💻', label: 'Developer' },
  { key: 'test', icon: '🧪', label: 'Test automation' },
  { key: 'data', icon: '🗄️', label: 'Data engineer' },
  { key: 'ba', icon: '📋', label: 'Business analyst' },
] as const;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const fmt = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
---
<section class="lens" data-role-lens data-active="dev" data-testid="role-lens">
  <div class="lens__head">
    <span class="lens__label"><span class="eyebrow">Through your lens</span><span class="lens__badge" title="Useful background, not examined">Beyond the exam guide</span></span>
    <div class="lens__tabs no-print" role="group" aria-label="Role">
      {ROLES.map((r, i) => (
        <button type="button" data-role={r.key} aria-pressed={i === 0 ? 'true' : 'false'} data-testid={`role-tab-${r.key}`}>
          <span aria-hidden="true">{r.icon}</span> {r.label}
        </button>
      ))}
    </div>
  </div>
  {ROLES.map((r) => (
    <p class="lens__body" data-role-body={r.key}><strong class="lens__who">{r.icon} {r.label}:</strong> <Fragment set:html={fmt(p[r.key])} /></p>
  ))}
</section>

<script>
  const KEY = 'ccdvf-role';
  const read = () => { try { return localStorage.getItem(KEY) ?? 'dev'; } catch { return 'dev'; } };
  const apply = (role: string) => {
    document.querySelectorAll<HTMLElement>('[data-role-lens]').forEach((box) => {
      box.dataset.active = role;
      box.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.role === role)));
    });
  };
  apply(read());
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-role-lens] [data-role]');
    if (!btn) return;
    const box = btn.closest<HTMLElement>('[data-role-lens]')!;
    const before = box.getBoundingClientRect().top;
    try { localStorage.setItem(KEY, btn.dataset.role!); } catch { /* storage blocked */ }
    apply(btn.dataset.role!);
    window.scrollBy(0, box.getBoundingClientRect().top - before);
  });
</script>

<style>
  .lens { margin: 1.25rem 0; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); border-left: 6px solid var(--pink); padding: 0.9rem 1.2rem 1rem; }
  .lens__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.6rem; }
  .lens__head .eyebrow { margin: 0; }
  .lens__label { display: inline-flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .lens__badge { font: 700 0.7rem var(--font-body); text-transform: uppercase; letter-spacing: 0.04em; color: var(--grey); border: 1px dashed var(--grey); border-radius: 999px; padding: 0.1rem 0.5rem; }
  .lens__tabs { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; }
  .lens__tabs button { border: 1px solid var(--line); background: var(--bg); color: var(--charcoal); font: 700 0.8rem var(--font-body); padding: 0.3rem 0.7rem; border-radius: 999px; cursor: pointer; }
  .lens__tabs button[aria-pressed='true'] { background: var(--pink); border-color: var(--pink); color: #fff; }
  .lens__body { margin: 0; line-height: 1.55; }
  .lens__who { color: var(--pink-dark); }
  .lens:not([data-active='dev']) [data-role-body='dev'],
  .lens:not([data-active='test']) [data-role-body='test'],
  .lens:not([data-active='data']) [data-role-body='data'],
  .lens:not([data-active='ba']) [data-role-body='ba'] { display: none; }
  @media print { .lens [data-role-body] { display: block !important; margin-bottom: 0.4rem; } }
</style>
