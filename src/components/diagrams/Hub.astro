---
/** A centre idea with related items arranged around it. */
import Figure from '../Figure.astro';
import { wrap } from '../../lib/svg';

interface Props { center: string; items: string[]; caption: string; }
const { center, items, caption } = Astro.props;
const n = items.length, cx = 410, cy = 178, rx = 300, ry = 128, w = 180, h = 54;
const pos = items.map((_, i) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
  return { x: cx + rx * Math.cos(a), y: cy + ry * Math.sin(a) };
});
---
<Figure caption={caption}>
  <svg class="dg-svg" viewBox="0 0 820 356" role="img" aria-label={`${center}: ${items.join(', ')}`}>
    {pos.map(({ x, y }) => <line class="ln-hub" x1={cx} y1={cy} x2={x} y2={y}/>)}
    <ellipse cx={cx} cy={cy} rx="112" ry="50" class="b-dark"/>
    {wrap(center, 18).map((l, j, all) => <text class="t" x={cx} y={cy + (j - (all.length - 1) / 2) * 19} style="font-size:17px">{l}</text>)}
    {items.map((it, i) => {
      const { x, y } = pos[i];
      const lines = wrap(it, 20);
      return (
        <g>
          <rect class="c-card c-card--end" x={x - w / 2} y={y - h / 2} width={w} height={h} rx="12"/>
          {lines.map((l, j) => <text class="t-title" x={x} y={y + (j - (lines.length - 1) / 2) * 17} style="font-size:14.5px">{l}</text>)}
        </g>
      );
    })}
  </svg>
  <div class="dg-phone dg-hub">
    <p class="dg-center">{center}</p>
    <ul>{items.map((it) => <li>{it}</li>)}</ul>
  </div>
</Figure>
