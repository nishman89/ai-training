---
/** A grid of labelled tiles (e.g. the five workflow patterns). */
import Figure from '../Figure.astro';
import { wrap } from '../../lib/svg';

interface Tile { label?: string; title: string; sub?: string; }
interface Props { tiles: Tile[]; caption: string; cols?: number; }
const { tiles, caption, cols = 4 } = Astro.props;
const gap = 16, w = (800 - gap * (cols - 1)) / cols;
const laid = tiles.map((t) => ({ title: wrap(t.title, Math.floor((w - 20) / 9.2)), sub: t.sub ? wrap(t.sub, Math.floor((w - 20) / 7.3)) : [] }));
const h = Math.max(116, 60 + Math.max(...laid.map((l) => l.title.length * 20 + l.sub.length * 18)));
const rowsN = Math.ceil(tiles.length / cols);
---
<Figure caption={caption}>
  <svg class="dg-svg" viewBox={`0 0 820 ${rowsN * (h + gap) + 4}`} role="img" aria-label={tiles.map((t) => t.title).join('; ')}>
    {tiles.map((t, i) => {
      const r = Math.floor(i / cols), inRow = r === rowsN - 1 ? tiles.length - r * cols : cols;
      const off = ((cols - inRow) * (w + gap)) / 2;
      const x = 10 + off + (i % cols) * (w + gap), y = 6 + r * (h + gap);
      const l = laid[i], label = t.label ?? String(i + 1);
      const badgeW = Math.max(30, label.length * 9 + 18);
      return (
        <g>
          <rect class="c-card" x={x} y={y} width={w} height={h} rx="14"/>
          <rect class="b-pink" x={x + 16} y={y} width={w - 32} height="5" rx="2.5"/>
          <rect class="b-pink" x={x + w / 2 - badgeW / 2} y={y + 16} width={badgeW} height="24" rx="12"/>
          <text class="t-num" x={x + w / 2} y={y + 28.5} style="font-size:12.5px">{label}</text>
          {l.title.map((s, j) => <text class="t-title" x={x + w / 2} y={y + 58 + j * 20}>{s}</text>)}
          {l.sub.map((s, j) => <text class="t-sub" x={x + w / 2} y={y + 62 + l.title.length * 20 + j * 18}>{s}</text>)}
        </g>
      );
    })}
  </svg>
  <ul class="dg-phone dg-tiles">
    {tiles.map((t, i) => (
      <li class="dg-step"><span class="dg-num">{t.label ?? i + 1}</span><strong>{t.title}</strong>{t.sub && <span>{t.sub}</span>}</li>
    ))}
  </ul>
</Figure>
