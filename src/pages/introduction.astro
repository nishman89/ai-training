---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CodeSwitch from '../components/CodeSwitch.astro';
import { GUIDE_V1_URL, GUIDE_V11_URL } from '../data/blueprint';
import { getChapters } from '../lib/data';
import { READING_ORDER } from '../data/prerequisites';
import { OVERVIEWS } from '../data/domain-overviews';
import { url, QUESTIONS_PER_CHAPTER } from '../lib/site';

const chapters = await getChapters();

const different = [
  ['🎲', 'Non-deterministic', 'Same input, different (but equivalent) answers. Exact-match assertions break, so you test properties and meaning, as you would a flaky UI with fuzzy assertions.'],
  ['🔁', 'Stateless', 'Like plain HTTP: no session on the server. Your app owns the conversation history and resends it on every call.'],
  ['🧮', 'Metered by tokens', 'You pay for input (everything you send, history and tool definitions included) and output (what it writes, about 5× pricier). Cost and latency grow with payload size.'],
  ['📏', 'Hard size limit', 'The context window caps input plus output for one request: 1M tokens on current models.'],
  ['💉', 'Data can act as code', 'Text the model reads can steer it, like unparameterised SQL. That is prompt injection, and the fix is structural, never a polite instruction.'],
  ['🛑', 'It never executes', 'It returns requests for actions. Your code decides whether to run them, and holds the real controls.'],
];

const map = [
  ['Messages API (POST /v1/messages)', 'Stateless JSON REST endpoint with an API-key header', 2],
  ['Java SDK (com.anthropic:anthropic-java)', 'Typed OkHttp client with builders and built-in retries', 2],
  ['stop_reason', 'An exit code you must branch on: 200 OK does not mean a complete answer', 2],
  ['429 / 529 + retry-after', 'Throttling vs upstream overload: backoff with jitter', 2],
  ['Streaming (SSE events)', 'A reactive stream: assemble chunks, commit only on completion', 2],
  ['Model tiers (Haiku → Fable)', 'Instance sizing: right-size per workload, route by job type', 5],
  ['max_tokens', 'A LIMIT on reply size: hitting it truncates silently, it does not throw', 5],
  ['Prompt caching', 'Memoising an identical request prefix: any byte change is a miss', 5],
  ['Batch API (50% off, ≤ 24 h)', 'A nightly batch job instead of a real-time call', 5],
  ['Workflows (chain, route, parallel)', 'A pipeline DAG you define, as in Airflow', 1],
  ['Agent loop', 'A while loop / state machine until a terminal state, with an iteration cap', 1],
  ['System prompt + few-shot examples', 'The spec, plus fixtures showing the expected output shape', 6],
  ['Structured outputs / strict tools', 'Schema validation at the boundary (JSON Schema)', 6],
  ['Context management', 'Managing a bounded buffer: trim, summarise, offload', 6],
  ['RAG', 'An indexing pipeline: chunk → embed → store → query → assemble', 6],
  ['Tool use', 'Command pattern: the model returns a command, your code executes it', 8],
  ['MCP', 'A driver standard like JDBC: one server, any compatible client', 8],
  ['Prompt injection', 'SQL injection / XSS: untrusted input treated as instructions', 7],
  ['Least privilege, secrets in a vault', 'Exactly what you do for any service account', 7],
  ['Evals + LLM-as-judge', 'A regression suite on a golden dataset; the judge is a fuzzy assertion you calibrate', 4],
  ['CLAUDE.md / hooks', 'A CONTRIBUTING.md for the agent / git hooks and CI gates', 3],
];

const firstCall = `AnthropicClient client = AnthropicOkHttpClient.fromEnv();   // reads ANTHROPIC_API_KEY

Message reply = client.messages().create(MessageCreateParams.builder()
    .model(Model.CLAUDE_HAIKU_5_5)       // which Claude: cheap and fast
    .maxTokens(200L)                     // cap on the reply length
    .system("You are a terse tutor.")    // standing instructions
    .addUserMessage("Explain idempotency in one sentence.")
    .build());

reply.content().forEach(b -> b.text().ifPresent(t -> System.out.println(t.text())));
System.out.println(reply.stopReason() + " | in=" + reply.usage().inputTokens()
                   + " out=" + reply.usage().outputTokens());`;

const firstCallTs = `import Anthropic from '@anthropic-ai/sdk';

const client = new Anthropic();             // reads ANTHROPIC_API_KEY

const reply = await client.messages.create({
  model: 'claude-haiku-5-5',                // which Claude: cheap and fast
  max_tokens: 200,                          // cap on the reply length
  system: 'You are a terse tutor.',         // standing instructions
  messages: [{ role: 'user', content: 'Explain idempotency in one sentence.' }],
});

console.log(reply.content.filter((b) => b.type === 'text').map((b) => b.text).join(''));
console.log(reply.stop_reason, '| in =', reply.usage.input_tokens, 'out =', reply.usage.output_tokens);`;
const firstCallPy = `import anthropic

client = anthropic.Anthropic()            # reads ANTHROPIC_API_KEY

reply = client.messages.create(
    model="claude-haiku-5-5",             # which Claude: cheap and fast
    max_tokens=200,                       # cap on the reply length
    system="You are a terse tutor.",      # standing instructions
    messages=[{"role": "user", "content": "Explain idempotency in one sentence."}],
)

print("".join(b.text for b in reply.content if b.type == "text"))
print(reply.stop_reason, "| in =", reply.usage.input_tokens, "out =", reply.usage.output_tokens)`;

const pom = `<dependency>
  <groupId>com.anthropic</groupId>
  <artifactId>anthropic-java</artifactId>
  <version>3.11.0</version>
</dependency>`;
/** Exam guide v1.1 (exams from 7 December 2026) weights, from multiple published summaries of the guide; check the official PDF. */
const V11: Record<number, number> = { 1: 17, 2: 20, 3: 8, 4: 10, 5: 12, 6: 15, 7: 8, 8: 10 };
---
<BaseLayout title="Start here" description="Claude for a Java, test-automation and data engineer: what's different about an LLM, a concept map, the exam at a glance and your first call.">
  <PageHead eyebrow="Start here" title="Claude for engineers" />

  <div class="container intro">
    <section class="lead card">
      <h2>You already know the engineering</h2>
      <p>What's new is the component in the middle: a model whose output is <strong>probabilistic, metered and steerable by text</strong>.
        Almost every exam topic is a familiar engineering idea applied to that component, so learn it as a mapping onto what you
        already do in Java, test automation, data engineering and business analysis.</p>
    </section>

    <section class="card codenote" data-testid="code-note">
      <h2>About the code examples</h2>
      <p>Most sections include code in <strong>Java, Python and TypeScript</strong>. It's there in case it helps, especially if you're a developer.
        <strong>You don't need to understand the code to pass.</strong> Many examples are folded away behind "Show the code", and each one has a
        plain-English "What this code does" list.</p>
      <p>What you do need: the <strong>key points at the end of every section</strong> (they're all on the <a href={url('summaries')}>Summaries</a> page),
        and the <strong>"How it all fits together"</strong> section at the end of each domain.</p>
    </section>

    <section id="reading-order" data-testid="reading-order">
      <h2 class="dot">The eight domains in plain English, in the order to read them</h2>
      <p>The site keeps the official domain numbers, which put agents first. For a first read, go in this order instead: each domain only
        builds on the ones before it. Unfamiliar words have a <span class="gl-demo">dotted underline</span>: hover over or tap them for a plain-English
        definition, or open the <a href={url('glossary')}>Glossary</a>. Each section also says what to <strong>📖 read first</strong>.</p>
      <ol class="order">
        {READING_ORDER.map((r, i) => {
          const ch = chapters.find((c) => c.data.number === r.domain)!;
          return (
            <li class="order__step card">
              <span class="order__n">{i + 1}</span>
              <div>
                <a class="order__title" href={url(`chapters/${r.domain}`)}>Domain {r.domain}: {ch.data.title} →</a>
                <p class="order__what">{OVERVIEWS[r.domain].what}</p>
                <p><strong>Why read it now:</strong> {r.why}</p>
              </div>
            </li>
          );
        })}
      </ol>
      <p class="muted small">Tip: on your first pass through a domain, switch on <strong>First read</strong> at the top of the notes. It hides the programming code (examples such as traces, replies and prompts stay visible),
        the role examples and the exam-guide boxes so you can get the ideas first.</p>
    </section>

    <section>
      <h2 class="dot">The exam at a glance</h2>
      <div class="facts">
        <div class="fact card card--dark"><span class="fact__big">53</span><span>multiple-choice and multiple-response questions (each says how many to pick). <strong>From 7 December: 70</strong></span></div>
        <div class="fact card card--dark"><span class="fact__big">120</span><span>minutes, about 2 min 15 s per question (about 1 min 40 s from 7 December)</span></div>
        <div class="fact card fact--pink"><span class="fact__big">720</span><span>out of 1,000 to pass (scaled score)</span></div>
        <div class="fact card card--dark"><span class="fact__big">8</span><span>domains, weighted very unevenly (below)</span></div>
      </div>
      <div class="card eligibility" data-testid="eligibility">
        <h3>Who can sit the exam</h3>
        <ul>
          <li><strong>Only people at Claude Partner Network companies.</strong> You register with your work email on the partner company's domain; personal email addresses aren't accepted. Customers and non-partners can't currently be certified.</li>
          <li><strong>Booked through Pearson VUE,</strong> taken online with a proctor or at a test centre. US$125 before any partner discount.</li>
          <li><strong>The pass mark is a scaled score:</strong> 720 on a scale of 100 to 1,000. That isn't the same as 72% of answers correct. The quizzes and mocks on this site use 72% as a rough practice target only.</li>
          <li><strong>Valid for 12 months</strong> from the day you pass.</li>
        </ul>
        <p class="muted small">Not at a partner company? Everything on this site still works as Claude developer training; you just can't book the exam yet. Source: Anthropic's certification FAQ on the Partner Academy.</p>
      </div>
      <div class="table-wrap weights">
        <table>
          <thead><tr><th>Domain</th><th>Weight<br /><span class="muted small">to 6 Dec</span></th><th>≈ Questions</th><th>Weight<br /><span class="muted small">from 7 Dec</span></th><th></th></tr></thead>
          <tbody>
            {chapters.map(({ data }) => (
              <tr>
                <td><a href={url(`chapters/${data.number}`)}><strong>{data.number}.</strong> {data.title}</a></td>
                <td>{data.weight}%</td>
                <td>{QUESTIONS_PER_CHAPTER[data.number]}</td>
                <td>{V11[data.number]}%</td>
                <td class="weights__bar"><span style={`width:${(data.weight / 33.1) * 100}%`}></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">Weights and numbering from the official <a href={GUIDE_V1_URL} target="_blank" rel="noopener">CCDV-F exam guide v1.0 ↗</a>
        (exams up to 6 December 2026). From 7 December the exam follows <a href={GUIDE_V11_URL} target="_blank" rel="noopener">guide v1.1 ↗</a>: still 120 minutes and a scaled 720 to pass, but <strong>70 questions</strong> (60 scored, 10 unscored that you can't tell apart) and the new weights in the last column. Evals and Claude Code count about three times as much, and Applications and Integration much less. Which version you sit depends on your appointment date.
        Each domain page lists that domain's official skills.</p>
      <p class="muted small">Domains 2, 5 and 1 (Applications, Model Selection, Agents) are about two-thirds of the exam: spend about two-thirds of your time there.</p>
    </section>

    <section>
      <h2 class="dot">What's genuinely different about an LLM dependency</h2>
      <div class="diff">
        {different.map(([icon, title, text]) => (
          <div class="card diff__card"><span class="diff__icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="dot">Map it onto what you know</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Claude concept</th><th>What you already know</th><th>Domain</th></tr></thead>
          <tbody>
            {map.map(([concept, known, d]) => (
              <tr><td><strong>{concept}</strong></td><td>{known}</td><td><a href={url(`chapters/${d}`)}>{d}</a></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="dot">Where your background gives you a head start</h2>
      <div class="grid">
        <div class="card"><span class="eyebrow">Business analysis</span><h3>Requirements → evals</h3><p>Acceptance criteria become eval cases. Functional vs infrastructure requirements (residency, latency, identity) and lifecycle gates are Domain 2.</p></div>
        <div class="card"><span class="eyebrow">Test automation</span><h3>Almost all of Domain 4</h3><p>Same discipline: golden dataset, baseline, one change at a time, release gate. The twist is non-determinism: property checks and a calibrated model judge instead of assertEquals on text.</p></div>
        <div class="card"><span class="eyebrow">Data engineering</span><h3>Batch, RAG, budgets</h3><p>The Batch API, chunk-and-embed pipelines, cost per run, idempotent retries, and token budgets as capacity planning.</p></div>
        <div class="card"><span class="eyebrow">Java (or Python)</span><h3>Every API concept</h3><p>The Java SDK is builder-pattern code with CompletableFuture async and a typed exception per HTTP status. The Python SDK is the same API with keyword arguments.</p></div>
      </div>
    </section>

    <section class="card first">
      <h2>Your first call</h2>
      <p>Add the official SDK (Maven for Java, <code>pip install anthropic</code> for Python, <code>npm install @anthropic-ai/sdk</code> for TypeScript), set <code>ANTHROPIC_API_KEY</code> from the Claude Console, then run.
        Every code example on this site has a <strong>Java / Python / TypeScript</strong> switch, and your choice is remembered.</p>
      <CodeSwitch title="Your first call" explain={[
        'Installs the official SDK (Maven, pip or npm).',
        'Creates a client, which reads your key from the `ANTHROPIC_API_KEY` environment variable.',
        'Sends one request: which model, a cap on the reply length, standing instructions (`system`) and the question.',
        'Prints the text of the reply, then why Claude stopped and how many tokens went in and out (what you are billed for).',
      ]}>
        <Code code={pom} lang="xml" />
        <Code code={firstCall} lang="java" />
        <Code code={'pip install anthropic'} lang="python" />
        <Code code={firstCallPy} lang="python" />
        <Code code={'npm install @anthropic-ai/sdk'} lang="bash" />
        <Code code={firstCallTs} lang="typescript" />
      </CodeSwitch>
      <p><strong>Then experiment, one variable at a time:</strong> drop <code>maxTokens</code> to 10 and watch <code>stop_reason</code> become
        <code>max_tokens</code>; ask the same question five times and diff the answers; send a long system prompt twice with caching on and read
        <code>usage</code>. Ten minutes of that teaches more than an hour of reading.</p>
    </section>

    <section class="card card--tint">
      <h2>How to use this site</h2>
      <ol class="steps">
        <li><strong>Follow the <a href="#reading-order">reading order</a> above.</strong> Each section is collapsible; tick sections off as you go. Every domain opens with a plain-English summary, then the detail, Java, Python and TypeScript examples, and links to the official docs. In the code, the lines under <strong>Setup</strong> show where each name comes from (the client, example inputs, and one-line notes for your own app's objects); the code under <strong>The example</strong> is the point being taught.</li>
        <li><strong>Spend most time on what's new to everyone:</strong> token and cost arithmetic, reading <code>stop_reason</code> and <code>usage</code>, the tool-use round trip, workflow vs agent, context strategies, and why prompt rules are never security controls.</li>
        <li><strong>Check the "Watch out for…" box</strong> at the end of each domain: the common confusions.</li>
        <li><strong>Before the exam, read the <a href={url('exam-tips')}>Exam tips</a>:</strong> practical tips by topic, each linked to the notes.</li>
        <li><strong>Revise from the <a href={url('summaries')}>Summaries</a> page:</strong> every section's key points on one page.</li>
        <li><strong>Take the domain quiz.</strong> Original practice questions in the exam's style, every option explained, each linked to the Claude doc it's based on.</li>
        <li><strong>Sit the <a href={url('mock-exam')}>mock exam</a></strong> when you've covered all eight domains.</li>
      </ol>
    </section>

    <p class="source muted">Exam format: the official CCDV-F exam guide v1.0 (July 2026). Model names, prices and limits are from
      the <a href="https://platform.claude.com/docs/en/models-overview" target="_blank" rel="noopener">Claude Platform docs</a> as of November 2026 and change often.</p>
  </div>
</BaseLayout>

<style>
  .intro { display: grid; gap: 2.5rem; }
  .lead { border-left: 8px solid var(--pink); }
  .codenote { border-left: 8px solid #5b6b80; }
  .eligibility { margin-top: 1rem; border-left: 8px solid var(--pink); }
  .eligibility h3 { margin-top: 0; }
  .eligibility ul { margin: 0 0 0.5rem; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .codenote p:last-child { margin-bottom: 0; }
  .lead p:last-child { margin-bottom: 0; }
  .grid h3 { margin-top: 0.25rem; }
  .facts { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .fact { display: flex; flex-direction: column; gap: 0.25rem; }
  .fact__big { font: 700 2.75rem/1 var(--font-head); color: var(--pink-soft); }
  .fact--pink { background: var(--pink); color: #fff; }
  .fact--pink .fact__big { color: #fff; }
  .weights { margin-top: 1.25rem; }
  .weights a { color: inherit; text-decoration: none; }
  .weights a:hover { color: var(--pink-dark); }
  .weights__bar { width: 35%; }
  .weights__bar span { display: block; height: 0.6rem; border-radius: 999px; background: var(--pink); }
  .small { font-size: 0.9rem; }
  .diff { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .diff__card { border-top: 6px solid var(--charcoal); }
  .diff__card h3 { margin: 0.4rem 0 0.3rem; }
  .diff__card p { margin: 0; }
  .diff__icon { font-size: 1.6rem; }
  .first { border-left: 8px solid var(--charcoal); }
  .first :global(pre) { margin: 0.75rem 0; }
  .steps { display: grid; gap: 0.6rem; padding-left: 1.25rem; }
  .source { font-size: 0.85rem; }
  .order { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 0.75rem; }
  .order__step { display: flex; gap: 1rem; align-items: flex-start; margin: 0; padding: 1rem 1.25rem; }
  .order__n { flex: none; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--pink); color: #fff; font: 700 1.1rem var(--font-head); }
  .order__title { font: 700 1.1rem var(--font-head); text-decoration: none; color: var(--charcoal); }
  .order__title:hover { color: var(--pink-dark); }
  .order__step p { margin: 0.25rem 0 0; color: var(--grey); }
  .order__step .order__what { color: var(--charcoal); font-weight: 600; }
  .gl-demo { text-decoration: underline dotted var(--pink); text-decoration-thickness: 2px; text-underline-offset: 3px; }
</style>
