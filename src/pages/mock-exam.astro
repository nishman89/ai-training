---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Quiz from '../components/Quiz.astro';
import { getMockExam } from '../lib/data';
import { GUIDE_V1_URL } from '../data/blueprint';
import { url, QUESTIONS_PER_CHAPTER, EXAM_QUESTIONS, EXAM_MINUTES } from '../lib/site';

const questions = await getMockExam(QUESTIONS_PER_CHAPTER);
---
<BaseLayout title="Mock exam" description="A timed CCDV-F style mock exam: questions weighted by domain, with a score per domain and every answer explained.">
  <PageHead eyebrow="Exam practice" title="Mock exam">
    <p class="lead">The real CCDV-F exam is {EXAM_QUESTIONS} multiple-choice and multiple-response questions in {EXAM_MINUTES} minutes,
      scored 100–1,000 with 720 to pass. That's a scaled score, not 72% correct; this mock uses 72% only as a rough practice target. This mock uses the same domain weighting ({questions.length} questions), a timer and a score by domain.
      Questions are original practice items, not real exam questions. Each one links (📚) to the official Claude documentation or Anthropic article it's based on, so you can check the answer at source.</p>
    <p class="back no-print"><a href={url()}>← All domains</a></p>
  </PageHead>
  <div class="container">
    <aside class="card official" data-testid="official-samples">
      <span class="eyebrow">📘 Official practice material</span>
      <h2>Is there an official mock exam?</h2>
      <p><strong>No.</strong> Anthropic doesn't publish a practice exam for CCDV-F. The only official practice items are the
        <strong>three sample questions in Section 8</strong> of the <a href={GUIDE_V1_URL} target="_blank" rel="noopener">exam guide v1.0 (PDF) ↗</a>.
        The guide says they aren't taken from the live question bank. Its Section 7 recommends the blueprint, the official docs, hands-on building and those samples.</p>
      <ul>
        <li><strong>Sample 1 · Domain 2:</strong> a large overnight document job where cost matters most. Practise with the Batch API questions in Domain 5.</li>
        <li><strong>Sample 2 · Domain 7:</strong> prompt injection in an agent that summarises web pages. Practise with the injection questions in Domain 7.</li>
        <li><strong>Sample 3 · Domain 8:</strong> giving several Claude apps reusable access to an internal REST service. Practise with the MCP questions in Domain 8.</li>
      </ul>
      <p class="official__note">Try the official three first, then this mock. Free "CCDV-F practice exam" sites are unofficial, and some still teach behaviour that has since changed.</p>
    </aside>
    <p class="next card no-print" data-testid="beta-link"><span class="beta">Beta</span> More practice: <a href={url('mock-exam-beta')}><strong>Mock exam 2</strong></a> (53 new questions, mixed order) or the <a href={url('mock-exam-quick')}><strong>Quick mock</strong></a> (15 questions, 35 minutes).</p>
    <Quiz questions={questions} quizId="mock-a" examMode />
  </div>
</BaseLayout>

<style>
  .lead { max-width: 52rem; }
  .back { margin: 1rem 0 0; font-weight: 700; }
  .official { margin: 0 0 2rem; border-top: 6px solid #3b6fd8; }
  .official h2 { margin-top: 0.2rem; }
  .next { margin: 0 0 2rem; padding: 0.9rem 1.2rem; }
  .beta { display: inline-block; margin-right: 0.4rem; padding: 0.05rem 0.55rem; border-radius: 999px; background: #f5a623; color: #2d2a2b; font-weight: 800; font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .official__note { color: var(--grey); font-size: 0.9rem; margin-bottom: 0; }
</style>
