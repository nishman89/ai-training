---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Quiz from '../components/Quiz.astro';
import { getExam } from '../lib/data';
import { url, EXAM_MINUTES } from '../lib/site';

const exam = await getExam('B');
const questions = exam.questions;
---
<BaseLayout title="Mock exam 2 (beta)" description="A second, 53-question CCDV-F style mock exam in mixed domain order, with a score per domain and every answer explained.">
  <PageHead eyebrow="Exam practice · Beta" title="Mock exam 2">
    <p class="lead"><span class="beta" data-testid="beta-badge">Beta</span> {questions.length} questions in {EXAM_MINUTES} minutes, in mixed domain order like the real exam,
      with a score by domain at the end. The 72% target is a rough guide: the real exam uses a scaled score (720 out of 1,000), not a fixed percentage. Each question shows its domain and the section of the notes it tests, and links (📚) to the official documentation it's based on.
      These are original practice questions written for this site, not real exam questions.</p>
    <p class="note">Where older material teaches something current models reject (setting temperature, prefilling the reply), the explanation says so and gives the current answer.</p>
    <p class="back no-print"><a href={url('mock-exam')}>← Mock exam 1</a> · <a href={url('mock-exam-quick')}>Quick mock (15)</a> · <a href={url()}>All domains</a></p>
  </PageHead>
  <div class="container">
    <Quiz questions={questions} quizId="mock-b" examMode />
  </div>
</BaseLayout>

<style>
  .lead { max-width: 52rem; }
  .note { max-width: 52rem; color: var(--grey); font-size: 0.95rem; }
  .beta { display: inline-block; margin-right: 0.4rem; padding: 0.05rem 0.55rem; border-radius: 999px; background: #f5a623; color: #2d2a2b; font-weight: 800; font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; vertical-align: middle; }
  .back { margin: 1rem 0 0; font-weight: 700; }
</style>
