---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Quiz from '../components/Quiz.astro';
import MockPicker from '../components/MockPicker.astro';
import { getExam } from '../lib/data';
import { url, EXAM_MINUTES, EXAM_QUESTIONS } from '../lib/site';

const exam = await getExam('C');
const questions = exam.questions;
const minutes = Math.round((questions.length / EXAM_QUESTIONS) * EXAM_MINUTES);
---
<BaseLayout title="Quick mock" description="A 15-question CCDV-F style quick mock across all eight domains, timed at the real exam's pace, with every answer explained.">
  <PageHead eyebrow="Exam practice · based on an unofficial paper" title="Quick mock">
    <p class="lead">{questions.length} questions in {minutes} minutes (the real exam's pace), covering all eight domains, with a score by domain at the end.
      Good for a quick check between study sessions. Each question shows its domain and the section of the notes it tests, and links (📚) to the official documentation it's based on.
      The questions are based on, but not copied from, an unofficial practice paper: the topics match, but the wording, scenarios and explanations are original. They are not real exam questions.</p>
  </PageHead>
  <div class="container">
    <MockPicker current="quick" />
    <Quiz questions={questions} quizId="mock-c" examMode examMinutes={minutes} />
  </div>
</BaseLayout>

<style>
  .lead { max-width: 52rem; }
  .note { max-width: 52rem; color: var(--grey); font-size: 0.95rem; }
  .back { margin: 1rem 0 0; font-weight: 700; }
</style>
